{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "enemies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "nome": {
            "type": "string",
            "minLength": 1
          },
          "tipo": {
            "enum": [
              "batalha",
              "elite",
              "chefe"
            ]
          },
          "liga": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "lider_hp": {
            "type": "integer",
            "minimum": 1
          },
          "deck": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "carta": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "iv_atk": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "iv_hp": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "nature": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "qtd": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "carta",
                "qtd"
              ],
              "additionalProperties": false,
              "dependentRequired": {
                "iv_atk": [
                  "iv_hp",
                  "nature"
                ],
                "iv_hp": [
                  "iv_atk",
                  "nature"
                ],
                "nature": [
                  "iv_atk",
                  "iv_hp"
                ]
              }
            }
          },
          "ia": {
            "enum": [
              "simples"
            ]
          },
          "regra_propria": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  },
                  "nome": {
                    "type": "string",
                    "minLength": 1
                  },
                  "texto": {
                    "type": "string",
                    "minLength": 1
                  },
                  "gatilho": {
                    "enum": [
                      "inicio_turno_proprio"
                    ]
                  },
                  "acao": {
                    "type": "object",
                    "properties": {
                      "tipo": {
                        "enum": ["dano", "cura", "buff_atk", "comprar", "energia"]
                      },
                      "alvo": {
                        "enum": ["inimigo_escolhido", "aliado_escolhido", "lider_inimigo", "lider_proprio", "nenhum"]
                      },
                      "valor": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "duracao": {
                        "oneOf": [
                          {"enum": ["permanente", "turno"]},
                          {"type": "null"}
                        ]
                      }
                    },
                    "required": ["tipo", "alvo", "valor"],
                    "additionalProperties": false
                  }
                },
                "required": ["id", "nome", "texto", "gatilho", "acao"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "falas": {
            "type": "object",
            "properties": {
              "vitoria": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "derrota": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "vitoria",
              "derrota"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "nome",
          "tipo",
          "liga",
          "deck",
          "ia",
          "falas"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "tipo": {
                  "enum": [
                    "batalha",
                    "elite"
                  ]
                }
              },
              "required": [
                "tipo"
              ]
            },
            "then": {
              "properties": {
                "regra_propria": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "enemies"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "enemies"
}
{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "cats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cat"
      }
    },
    "deck": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "maxItems": 12
    },
    "coins": {
      "type": "integer",
      "minimum": 0
    },
    "next_cat_id": {
      "type": "integer",
      "minimum": 1
    },
    "breeding": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "male": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "female": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "runs_left": {
            "type": "integer",
            "minimum": 0
          },
          "ration": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              }
            ]
          },
          "ration_choice": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "stat": {
                    "enum": [
                      "atk",
                      "hp"
                    ]
                  },
                  "parent": {
                    "enum": [
                      "father",
                      "mother"
                    ]
                  }
                },
                "required": [
                  "stat",
                  "parent"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "male",
          "female",
          "runs_left",
          "ration",
          "ration_choice"
        ],
        "additionalProperties": false
      }
    },
    "pity": {
      "type": "object",
      "properties": {
        "runs_without_high_iv": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "runs_without_high_iv"
      ],
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "properties": {
        "leagues_cleared": {
          "type": "integer",
          "minimum": 0
        },
        "best_distance": {
          "type": "integer",
          "minimum": 0
        },
        "records": {
          "type": "object"
        }
      },
      "required": [
        "leagues_cleared",
        "best_distance",
        "records"
      ],
      "additionalProperties": false
    },
    "dex": {
      "type": "object",
      "properties": {
        "breeds_seen": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "perfect_cats": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        }
      },
      "required": [
        "breeds_seen",
        "perfect_cats"
      ],
      "additionalProperties": false
    },
    "items": {
      "type": "object",
      "properties": {
        "nature_item": {
          "type": "boolean"
        }
      },
      "required": [
        "nature_item"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": "object"
    },
    "pending_adoption": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "cats": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/cat"
                  },
                  {
                    "properties": {
                      "stage": {
                        "const": "adult"
                      }
                    }
                  }
                ]
              }
            },
            "result": {
              "enum": [
                "vitoria",
                "derrota"
              ]
            },
            "nodes_cleared": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "cats",
            "result",
            "nodes_cleared"
          ],
          "additionalProperties": false
        }
      ]
    },
    "prestige": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "areas_unlocked": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true,
      "default": []
    },
    "rations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "decorations_owned": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "first_league_win_claimed": {
      "type": "boolean"
    },
    "legacy_capacity": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "lifetime": {
      "type": "object",
      "properties": {
        "runs_completed": {
          "type": "integer",
          "minimum": 0
        },
        "duels_won": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "runs_completed",
        "duels_won"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "cats",
    "deck",
    "coins",
    "next_cat_id",
    "breeding",
    "pity",
    "progress",
    "dex",
    "items",
    "settings",
    "prestige",
    "areas_unlocked",
    "rations",
    "decorations_owned",
    "first_league_win_claimed",
    "lifetime"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "save",
  "$defs": {
    "cat": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "breed": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "sex": {
          "enum": [
            "M",
            "F"
          ]
        },
        "nature": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "iv_atk": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "iv_hp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "stage": {
          "enum": [
            "kitten",
            "adult"
          ]
        },
        "rest_runs_left": {
          "type": "integer",
          "minimum": 0
        },
        "runs_as_kitten": {
          "type": "integer",
          "minimum": 0
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "parents": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "maxItems": 2,
          "oneOf": [
            {
              "maxItems": 0
            },
            {
              "minItems": 2
            }
          ]
        },
        "history": {
          "type": "object",
          "properties": {
            "runs": {
              "type": "integer",
              "minimum": 0
            },
            "duels_won": {
              "type": "integer",
              "minimum": 0
            },
            "bosses_defeated": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "runs",
            "duels_won",
            "bosses_defeated"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "breed",
        "sex",
        "nature",
        "iv_atk",
        "iv_hp",
        "stage",
        "rest_runs_left",
        "runs_as_kitten",
        "generation",
        "parents",
        "history"
      ],
      "additionalProperties": false
    }
  }
}

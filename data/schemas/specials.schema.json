{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "specials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "nome": {
            "type": "string",
            "minLength": 1
          },
          "custo": {
            "type": "integer",
            "minimum": 1
          },
          "atk": {
            "type": "integer",
            "minimum": 1
          },
          "hp": {
            "type": "integer",
            "minimum": 1
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "efeito_ao_entrar": {
            "oneOf": [
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "tipo": {
                      "enum": [
                        "dano",
                        "cura",
                        "buff_atk",
                        "comprar",
                        "energia"
                      ]
                    },
                    "alvo": {
                      "enum": [
                        "inimigo_escolhido",
                        "aliado_escolhido",
                        "lider_inimigo",
                        "lider_proprio",
                        "nenhum"
                      ]
                    },
                    "valor": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "duracao": {
                      "oneOf": [
                        {
                          "enum": [
                            "permanente",
                            "turno"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "tipo",
                    "alvo",
                    "valor"
                  ],
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "tipo": {
                            "enum": [
                              "comprar",
                              "energia"
                            ]
                          }
                        },
                        "required": [
                          "tipo"
                        ]
                      },
                      "then": {
                        "properties": {
                          "alvo": {
                            "const": "nenhum"
                          }
                        }
                      }
                    }
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "texto": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "nome",
          "custo",
          "atk",
          "hp",
          "keywords",
          "texto"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "specials"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "specials"
}
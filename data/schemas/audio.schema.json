{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "volumes",
    "sfx",
    "music",
    "contexts"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "volumes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "musica",
        "efeitos"
      ],
      "properties": {
        "musica": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "efeitos": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "sfx": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "files",
          "volume",
          "cooldown_ms"
        ],
        "properties": {
          "files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^sfx/[a-z0-9_]+\\.ogg$"
            }
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "cooldown_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "volume",
          "loop"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^music/[a-z0-9_]+\\.ogg$"
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "loop": {
            "type": "boolean"
          }
        }
      }
    },
    "contexts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
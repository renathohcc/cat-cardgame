{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "nome": {
            "type": "string",
            "minLength": 1
          },
          "custo": {
            "type": "integer",
            "minimum": 1
          },
          "texto": {
            "type": "string",
            "minLength": 1
          },
          "acoes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "tipo": {
                  "enum": [
                    "dano",
                    "cura",
                    "buff_atk",
                    "comprar",
                    "energia"
                  ]
                },
                "alvo": {
                  "enum": [
                    "inimigo_escolhido",
                    "aliado_escolhido",
                    "lider_inimigo",
                    "lider_proprio",
                    "nenhum"
                  ]
                },
                "valor": {
                  "type": "integer",
                  "minimum": 1
                },
                "duracao": {
                  "oneOf": [
                    {
                      "enum": [
                        "permanente",
                        "turno"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "tipo",
                "alvo",
                "valor"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "tipo": {
                        "enum": [
                          "comprar",
                          "energia"
                        ]
                      }
                    },
                    "required": [
                      "tipo"
                    ]
                  },
                  "then": {
                    "properties": {
                      "alvo": {
                        "const": "nenhum"
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "nome",
          "custo",
          "texto",
          "acoes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "effects"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "effects"
}